        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#888888;fontColor=#E0E0E0;fontSize=10;align=left;verticalAlign=top;spacing=8;dashed=1;" value="&lt;b&gt;Wyniki feedu&lt;/b&gt;&lt;br&gt;&lt;b&gt;OK&lt;/b&gt; — jest delta, idzie do bucketu&lt;br&gt;&lt;b&gt;EMPTY&lt;/b&gt; — snapshot nowy, brak zmian&lt;br&gt;&lt;b&gt;STALE&lt;/b&gt; — API nie odświeżyło danych&lt;br&gt;&lt;b&gt;ERR&lt;/b&gt; — błąd pobrania lub walidacji&lt;br&gt;&lt;br&gt;&lt;b&gt;Samonaprawa&lt;/b&gt;&lt;br&gt;STATE zapisywany po udanym uploadzie: nieudany cykl nie przesuwa stanu, więc następny tick wylicza tę samą deltę ponownie." vertex="1">
          <mxGeometry height="200" width="200" x="1250" y="420" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
