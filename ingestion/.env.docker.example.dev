# =============================================================================
# .env.docker.dev.example — szablon konfiguracji pollera LIVE w kontenerze (DEV)
# -----------------------------------------------------------------------------
# Skopiuj do .env.docker.dev i uzupełnij wartości < ... >. Plik z realnymi
# wartościami NIE trafia do repo (wykluczony w .gitignore). Ścieżki *_HOST_DIR
# wskazują lokalizacje na maszynie-hoście (montowane do kontenera).
# =============================================================================

# ── PKP: klucz API (dostęp do danych PKP PLK) ────────────────────────────────
PKP_API_KEY=< klucz api >

# ── PKP: baza Oracle ADB + Object Storage ────────────────────────────────────
PKP_ENV=< nazwa instancji / gałąź w strukturze Data, np. DEV >
PKP_WALLET_PASSWORD=< hasło do walletu; puste dla walletu SSO (cwallet.sso) >
PKP_DB_USER=< użytkownik bazy >
PKP_DB_PASSWORD=< hasło do bazy >
PKP_DB_DSN=< DSN z tnsnames.ora, np. pkpdev_high >
PKP_OCI_PROFILE=< profil z pliku config OCI, np. DEFAULT >
PKP_OCI_BUCKET_LIVE=< bucket na dane LIVE >
PKP_OCI_BUCKET=< bucket na dane daily (bronze) >

# ── Strefa czasowa kontenera ─────────────────────────────────────────────────
TZ=Europe/Warsaw

# ── Ścieżki wewnątrz kontenera (stałe — nie zmieniać) ────────────────────────
PKP_WALLET_DIR=/wallet
PKP_DATA_ROOT=/app/ingestion/Data
PKP_OCI_CONFIG_FILE=/oci/config.docker

# ── Ścieżki na hoście (montowane do kontenera — dostosuj do swojej maszyny) ───
PKP_DATA_HOST_DIR=< katalog Data na hoście, np. C:\jan.kowalski\stream_pkp\ingestion\Data >
PKP_WALLET_HOST_DIR=< katalog walletu na hoście, np. C:\jan.kowalski\stream_pkp\OCI\Wallet_PKPDEV >
PKP_OCI_CONFIG_HOST_DIR=< katalog z configiem OCI na hoście, np. C:\jan.kowalski\stream_pkp\OCI >

# ── PKP: parametry pipeline ──────────────────────────────────────────────────
PKP_STATION_ID=< id stacji z API, np. 60103 (Wrocław Główny) >
PKP_TICK_SECONDS=< odstęp między tickami pollera w sekundach, np. 180 >