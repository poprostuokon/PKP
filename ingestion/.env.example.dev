# ── PKP: Oracle ADB (wallet), bucket ──
PKP_ENV=< nazwa środowiska >
PKP_API_KEY=< klucz api >
PKP_WALLET_DIR=< ścieżka do katalogu Wallet, np. C:\jan.kowalski\stream_pkp\OCI\Wallet_PKPDEV >
PKP_DATA_ROOT=< ścieżka do katalogu Data, np. C:\jan.kowalski\stream_pkp\data >
PKP_WALLET_PASSWORD=< hasło do walletu >
PKP_DB_USER=< nazwa użytkownika bazy danych >
PKP_DB_PASSWORD=< hasło do bazy danych >
PKP_DB_DSN=< dsn do bazy danych >
PKP_OCI_PROFILE=< profil OCI z configu >
PKP_OCI_BUCKET_LIVE=< bucket OCI z configu dla live >
PKP_OCI_BUCKET=< bucket OCI z configu >

# ── PKP: parametry pipeline ──
PKP_STATION_ID=< id stacji z api, np. 60103 >
PKP_TICK_SECONDS=< liczba sekund między kolejnymi tickami, np. 180 >