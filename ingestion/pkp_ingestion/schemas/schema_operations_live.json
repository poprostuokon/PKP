{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "operations_live",
  "description": "LIVE operations (flaga szczegolow off): stations[] tylko wlasna stacja. Required = pola potrzebne do diffa i operation_tracking_log.",
  "type": "object",
  "required": ["generatedAt", "trains"],
  "additionalProperties": true,
  "properties": {
    "generatedAt": { "type": "string" },
    "trains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scheduleId", "orderId", "trainOrderId", "operatingDate", "trainStatus", "stations"],
        "additionalProperties": true,
        "properties": {
          "scheduleId":     { "type": "integer" },
          "orderId":        { "type": "integer" },
          "trainOrderId":   { "type": "integer" },
          "operatingDate":  { "type": "string" },
          "trainStatus":    { "type": "string" },
          "stations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stationId", "plannedSequenceNumber"],
              "additionalProperties": true,
              "properties": {
                "stationId":             { "type": "integer" },
                "plannedSequenceNumber": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}