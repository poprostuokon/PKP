{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "operations",
  "description": "Walidacja struktury odpowiedzi /api/v1/operations. Required = pola uzywane w silver (operation_header/details) + sterowanie paginacja. additionalProperties: nowe pola sa dozwolone.",
  "type": "object",
  "required": ["generatedAt", "pagination", "trains"],
  "additionalProperties": true,
  "properties": {
    "generatedAt": { "type": "string" },
    "pagination": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "page":         { "type": "integer" },
        "pageSize":     { "type": "integer" },
        "totalCount":   { "type": "integer" },
        "totalPages":   { "type": "integer" },
        "hasNextPage":  { "type": "boolean" }
      }
    },
    "trains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scheduleId", "orderId", "trainOrderId", "operatingDate", "stations"],
        "additionalProperties": true,
        "properties": {
          "scheduleId":    { "type": "integer" },
          "orderId":       { "type": "integer" },
          "trainOrderId":  { "type": "integer" },
          "operatingDate": { "type": "string" },
          "trainStatus":   { "type": "string" },
          "stations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stationId", "plannedSequenceNumber", "actualSequenceNumber"],
              "additionalProperties": true,
              "properties": {
                "stationId":                { "type": "integer" },
                "plannedSequenceNumber":    { "type": "integer" },
                "actualSequenceNumber":     { "type": "integer" },
                "actualArrival":            { "type": "string" },
                "actualDeparture":          { "type": "string" },
                "arrivalDelayMinutes":      { "type": "integer" },
                "departureDelayMinutes":    { "type": "integer" },
                "isConfirmed":              { "type": "boolean" },
                "isCancelled":              { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}