# =============================================================================
# .env.prod.example — szablon konfiguracji lokalnej (uruchamianie bez Dockera, PROD)
# -----------------------------------------------------------------------------
# Skopiuj do .env.prod i uzupełnij wartości < ... >. Plik z realnymi wartościami
# NIE trafia do repo (wykluczony w .gitignore). Ścieżki wskazują lokalizacje
# bezpośrednio na Twojej maszynie (praca lokalna, nie kontener).
# =============================================================================

# ── PKP: baza Oracle ADB (wallet) + Object Storage ───────────────────────────
PKP_ENV=< nazwa instancji / gałąź w strukturze Data, np. PROD >
PKP_API_KEY=< klucz api (dostęp do danych PKP PLK) >
PKP_WALLET_DIR=< katalog rozpakowanego walletu, np. C:\jan.kowalski\stream_pkp\OCI\Wallet_PKPPROD >
PKP_DATA_ROOT=< katalog Data (struktura TODO/ARCHIVE/...), np. C:\jan.kowalski\stream_pkp\data >
PKP_WALLET_PASSWORD=< hasło do walletu; puste dla walletu SSO (cwallet.sso) >
PKP_DB_USER=< użytkownik bazy >
PKP_DB_PASSWORD=< hasło do bazy >
PKP_DB_DSN=< DSN z tnsnames.ora, np. pkpprod_high >
PKP_OCI_PROFILE=< profil z pliku config OCI, np. DEFAULT >
PKP_OCI_BUCKET_LIVE=< bucket na dane LIVE >
PKP_OCI_BUCKET=< bucket na dane daily (bronze) >
# PKP_OCI_CONFIG_FILE=< opcjonalnie: ścieżka do configu OCI; puste = domyślny ~/.oci/config >

# ── PKP: parametry pipeline ──────────────────────────────────────────────────
PKP_STATION_ID=< id stacji z API, np. 60103 (Wrocław Główny) >
PKP_TICK_SECONDS=< odstęp między tickami pollera w sekundach, np. 180 >