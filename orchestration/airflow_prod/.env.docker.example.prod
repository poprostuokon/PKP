# ── Docker Compose prod environment for Airflow ──
COMPOSE_PROJECT_NAME=pkp-airflow-daily-prod
AIRFLOW_PORT=< port for localhost, e.g. 8081 >

# ── Metadata Airflow (Postgres w kontenerze) ──
AIRFLOW_DB_USER=< użytkownik bazy >
AIRFLOW_DB_PASSWORD=< hasło bazy >
AIRFLOW_DB_NAME=< nazwa bazy >

# ── Konto admina do UI (localhost:8081) ──
AIRFLOW_ADMIN_USERNAME=< nazwa użytkownika >
AIRFLOW_ADMIN_PASSWORD=< hasło administratora >
AIRFLOW_ADMIN_EMAIL=< adres email administratora >

# ── PKP: Oracle ADB (wallet), bucket
PKP_ENV=PROD
PKP_API_KEY=< klucz api >
PKP_WALLET_HOST_DIR=< katalog walletu na hoście, np. C:\Users\jan.kowalski\pkp\OCI\Wallet_PKPPROD >
PKP_WALLET_PASSWORD=< hasło walletu >
PKP_DB_USER=DEV_APP
PKP_DB_PASSWORD=< hasło bazy >
PKP_DB_DSN=< DSN z tnsnames.ora, np. pkpprod_high >
PKP_OCI_CONFIG_HOST_DIR=< katalog z configiem OCI na hoście, np. C:\Users\jan.kowalski\pkp\OCI >
PKP_OCI_PROFILE=< profil z pliku config OCI, np. DEFAULT >
PKP_OCI_BUCKET=< bucket na dane daily, np. prod-pkp >
PKP_OCI_BUCKET_LIVE=< bucket na dane live, np. prod-pkp-live >

# ── keepalive DEV (prod pinguje DEV, żeby nie usnął) ──
KEEPALIVE_DEV_DSN=< DSN z tnsnames.ora, np. pkpdev_high >
KEEPALIVE_DEV_USER=< użytkownik bazy, np. DEV_APP >
KEEPALIVE_DEV_PASSWORD=< hasło bazy >
KEEPALIVE_DEV_WALLET_PASSWORD=< hasło walletu >
KEEPALIVE_DEV_WALLET_DIR=< katalog walletu na hoście, np. /wallet_dev >
PKP_WALLET_DEV_HOST_DIR=< katalog walletu na hoście, np. C:\Users\jan.kowalski\pkp\OCI\Wallet_PKPDEV >

# ── PKP: raport (SMTP) ──
SMTP_HOST=< host SMTP, np. smtp.mailersend.net >
SMTP_PORT=< port SMTP, np. 465 >
SMTP_USER=< użytkownik SMTP >
SMTP_PASSWORD=< hasło SMTP >
SENDER_EMAIL=< adres email nadawcy >
SENDER_NAME=< nazwa nadawcy >
REPORT_EMAIL=< adres email odbiorcy raportu >

# ── PKP: parametry pipeline ──
PKP_STATION_ID=< id stacji z API, np. 60103 (Wrocław Główny) >
PKP_TICK_SECONDS=< odstęp między tickami pollera w sekundach, np. 180 >